# Public site URL (used for canonical links, sitemap, Open Graph, structured data).
NEXT_PUBLIC_SITE_URL=https://ora-tashkent.vercel.app

# --- Reservations (optional) -------------------------------------------------
# With both values set, the booking form delivers requests straight to the
# restaurant's Telegram chat and shows "Request sent" only after Telegram
# confirms delivery. Without them, the form prepares the message and asks the
# guest to press Send in Telegram themselves (honest manual flow).
# 1. Create a bot with @BotFather and paste its token here.
# 2. Add the bot to the staff chat/group, send it a message, and read the chat id
#    from https://api.telegram.org/bot<TOKEN>/getUpdates
# These are read at build time for the page and at runtime by /api/reservation:
# redeploy after changing them.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public booking bot username (e.g. @OraBookingBot). Empty = card shows "Soon".
NEXT_PUBLIC_TELEGRAM_BOT=
